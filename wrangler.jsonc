{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-tracker",
      "database_id": "5ba3dd81-78bd-4892-89c6-60dbd999259d",
      "migrations_dir": "migrations"
    }
  ]
}
